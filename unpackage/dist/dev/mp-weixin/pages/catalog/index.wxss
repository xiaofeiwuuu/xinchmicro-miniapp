.container {
  min-height: 100vh;
  background-color: #0A1A2F;
  padding: 20rpx;
  box-sizing: border-box;
  transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  padding: 20rpx;
}
.catalog-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.catalog-list .catalog-item {
  width: calc(50% - 20rpx);
  margin-bottom: 20rpx;
  background: #122642;
  border-radius: 16rpx;
  border: 1px solid rgba(255, 255, 255, 0.05);
  transition: all 0.3s ease;
  overflow: hidden;
}
.catalog-list .catalog-item .catalog-content {
  padding: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
}
.catalog-list .catalog-item .catalog-content .catalog-name {
  font-size: 36rpx;
  color: #FFFFFF;
  font-weight: 500;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
  letter-spacing: 1px;
}
.catalog-list .catalog-item:active {
  -webkit-transform: scale(0.98);
          transform: scale(0.98);
  background: #152d4e;
}
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}
.loading-state .loading-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 1px;
}
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}
.empty-state .iconfont {
  font-size: 80rpx;
  color: rgba(255, 255, 255, 0.2);
  margin-bottom: 20rpx;
}
.empty-state .empty-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
}
