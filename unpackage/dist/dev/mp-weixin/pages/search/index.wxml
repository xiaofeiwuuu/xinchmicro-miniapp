<view class="container blue"><view class="tabs"><block wx:for="{{tabs}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['switchTab',[index]]]]]}}" class="{{['tab-item',(currentTab===index)?'active':'']}}" bindtap="__e"><text>{{item}}</text></view></block></view><block wx:if="{{currentTab===0}}"><view class="search-box"><view class="search-input"><text class="iconfont icon-search"></text><input type="text" placeholder="请输入产品型号搜索" data-event-opts="{{[['input',[['__set_model',['','modelKeyword','$event',[]]],['handleModelSearch',['$event']]]]]}}" value="{{modelKeyword}}" bindinput="__e"/></view><view class="search-results"><block wx:if="{{$root.g0}}"><view class="empty-state"><text class="iconfont icon-empty"></text><text>未找到相关产品</text></view></block><block wx:if="{{$root.g1>0}}"><view><block wx:for="{{groupedModelProducts}}" wx:for-item="group" wx:for-index="index" wx:key="index"><view class="catalog-group"><view class="catalog-title">{{group.catalogName}}</view><view class="catalog-table" style="max-height:400rpx;overflow-y:auto;"><zb-table vue-id="{{'bda12f3c-1-'+index}}" columns="{{group.columns}}" data="{{group.products}}" border="{{true}}" fit="{{true}}" stripe="{{true}}" data-event-opts="{{[['^rowClick',[['navigateToProduct']]]]}}" bind:rowClick="__e" bind:__l="__l" vue-slots="{{['empty']}}"><view class="empty-state" slot="empty"><text class="iconfont icon-empty"></text><text>暂无产品</text></view></zb-table></view></view></block></view></block></view></view></block><block wx:if="{{currentTab===1}}"><view class="param-search"><view class="filter-box"><view class="filter-tags"><view data-event-opts="{{[['tap',[['openSelector',['$event']]]]]}}" class="tag" bindtap="__e"><text>{{getSelectedText}}</text><text class="iconfont icon-down"></text></view></view></view><block wx:if="{{selectedCatalog&&showParamFilters}}"><view class="param-filters"><block wx:for="{{$root.l0}}" wx:for-item="label" wx:for-index="key" wx:key="key"><view class="param-item"><text class="param-label">{{key}}</text><block wx:if="{{label.g2}}"><view class="range-inputs"><input class="range-input" type="text" placeholder="最小值" data-event-opts="{{[['input',[['__set_model',['$0','min','$event',[]],['paramFilters.'+key+'']],['handleParamFilter',['$event']]]]]}}" value="{{paramFilters[key].min}}" bindinput="__e"/><text class="range-separator">-</text><input class="range-input" type="text" placeholder="最大值" data-event-opts="{{[['input',[['__set_model',['$0','max','$event',[]],['paramFilters.'+key+'']],['handleParamFilter',['$event']]]]]}}" value="{{paramFilters[key].max}}" bindinput="__e"/></view></block><block wx:else><input class="normal-input" type="text" placeholder="{{'请输入'+key}}" data-event-opts="{{[['input',[['__set_model',['$0',key,'$event',[]],['paramFilters']],['handleParamFilter',['$event']]]]]}}" value="{{paramFilters[key]}}" bindinput="__e"/></block></view></block></view></block><block wx:if="{{$root.g3>0}}"><view class="search-results" style="height:40vh;"><zb-table vue-id="bda12f3c-2" columns="{{columns}}" data="{{filteredProducts}}" fit="{{true}}" border="{{true}}" stripe="{{true}}" height="calc(100vh - 400rpx)" data-event-opts="{{[['^rowClick',[['navigateToProduct']]]]}}" bind:rowClick="__e" bind:__l="__l" vue-slots="{{['empty']}}"><view class="empty-state" slot="empty"><text class="iconfont icon-empty"></text><text>暂无产品</text></view></zb-table></view></block></view></block><block wx:if="{{currentTab===2}}"><view class="search-results"><view class="section-card"><view class="section-header"><text class="section-title">产品资料</text></view><view class="tip-box"><text class="tip-text">点击下载按钮可分享好友或在浏览器粘贴链接进行下载,点击查看按钮可查看PDF,右上角保存或转发文件,文件较大，请在wifi环境下载查看</text></view><block wx:if="{{$root.g4>0}}"><view><block wx:for="{{manualsList}}" wx:for-item="manual" wx:for-index="index" wx:key="id"><view class="pdf-box"><text class="pdf-name">{{manual.name}}</text><view class="download-box"><text data-event-opts="{{[['tap',[['downloadManual',[['o',['manual',manual],['type','view']]]]]]]}}" class="download-text" style="margin-right:20rpx;" bindtap="__e">查看</text><text data-event-opts="{{[['tap',[['downloadManual',[['o',['manual',manual],['type','copy']]]]]]]}}" class="download-text" bindtap="__e">下载</text></view></view></block><block wx:if="{{manualsTotal>manualsPageSize}}"><view class="pagination"><view class="pagination-info"><text>{{"共 "+manualsTotal+" 条"}}</text></view><view class="pagination-controls"><view data-event-opts="{{[['tap',[['changeManualsPage',[manualsPage-1]]]]]}}" class="{{['pagination-btn',(manualsPage<=1)?'disabled':'']}}" bindtap="__e"><text class="iconfont icon-left"></text></view><view class="pagination-page"><text>{{manualsPage}}</text></view><view data-event-opts="{{[['tap',[['changeManualsPage',[manualsPage+1]]]]]}}" class="{{['pagination-btn',(manualsPage>=$root.g5)?'disabled':'']}}" bindtap="__e"><text class="iconfont icon-right"></text></view></view></view></block></view></block><block wx:else><view class="empty-state"><text class="iconfont icon-empty"></text><text>暂无产品手册</text></view></block></view></view></block><popup-selector vue-id="bda12f3c-3" show="{{showSelector}}" title="{{selectorTitle}}" list="{{selectorList}}" selectedId="{{selectedId}}" showBack="{{showBack}}" data-event-opts="{{[['^close',[['handleClose']]],['^select',[['handleSelect']]],['^back',[['handleBack']]]]}}" bind:close="__e" bind:select="__e" bind:back="__e" bind:__l="__l"></popup-selector><block wx:if="{{isDownloading}}"><view class="download-progress-container"><view data-event-opts="{{[['touchstart',[['handleLongPressStart',['$event']]]],['touchend',[['handleLongPressEnd',['$event']]]],['touchcancel',[['handleLongPressEnd',['$event']]]]]}}" class="progress-circle" bindtouchstart="__e" bindtouchend="__e" bindtouchcancel="__e"><canvas class="progress-canvas" type="2d" id="progressCanvas"></canvas><view class="progress-info"><view class="progress-percent">{{$root.g6+"%"}}</view></view><block wx:if="{{showLongPressHint}}"><view class="long-press-hint"><view class="hint-text">{{canCancelDownload?'松手取消':'长按3秒取消'}}</view></view></block></view></view></block></view>