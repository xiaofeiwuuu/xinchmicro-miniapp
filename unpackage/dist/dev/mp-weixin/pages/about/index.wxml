<view class="container blue"><view class="header-card"><view class="company-logo"><image src="{{$root.m0}}" mode="aspectFit"></image></view><text class="company-name">{{companyInfo.name||'芯辰微'}}</text><text class="company-desc">{{companyInfo.description||'厦门芯辰微电子有限公司成立于2020年，总公司位于厦门，在石家庄、成都设有分公司'}}</text></view><view class="info-card"><view class="info-item"><view class="info-left"><view class="icon-box"><image class="iconfont" src="/static/icon/phone.png" mode="aspectFit"></image></view><view class="info-content"><text class="info-label">联系电话</text><view class="info-value"><block wx:if="{{$root.g0}}"><text><block wx:for="{{$root.l0}}" wx:for-item="contact" wx:for-index="index" wx:key="index"><text><text data-event-opts="{{[['tap',[['handlePhone',['$0'],[[['companyInfo.contacts','',index]]]]]]]}}" bindtap="__e">{{contact.$orig}}</text><block wx:if="{{index<contact.g1-1}}"><text>|</text></block></text></block></text></block><block wx:else><text>暂无联系方式</text></block></view></view></view></view><view data-event-opts="{{[['tap',[['handleEmail',['$event']]]]]}}" class="info-item" bindtap="__e"><view class="info-left"><view class="icon-box"><image class="iconfont" src="/static/icon/email.png" mode="aspectFit"></image></view><view class="info-content"><text class="info-label">电子邮箱</text><text class="info-value">{{companyInfo.email||'暂无邮箱'}}</text></view></view></view><view data-event-opts="{{[['tap',[['handleWebsite',['$event']]]]]}}" class="info-item" bindtap="__e"><view class="info-left"><view class="icon-box"><image class="iconfont" src="/static/icon/gs.png" mode="aspectFit"></image></view><view class="info-content"><text class="info-label">官方网站</text><text class="info-value">{{companyInfo.website||'暂无网站'}}</text></view></view></view><view data-event-opts="{{[['tap',[['handleAddress',['$event']]]]]}}" class="info-item" bindtap="__e"><view class="info-left"><view class="icon-box"><image class="iconfont" src="/static/icon/address.png" mode="aspectFit"></image></view><view class="info-content"><text class="info-label">公司地址</text><text class="info-value">{{companyInfo.address||'暂无地址'}}</text></view></view></view></view></view>