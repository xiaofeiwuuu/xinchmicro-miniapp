.container {
  min-height: 100vh;
  background-color: #0A1A2F;
  padding: 20rpx;
  box-sizing: border-box;
  transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  box-sizing: border-box;
  padding: 0;
}
.container.blue .company-name {
  color: #FFFFFF;
  text-shadow: 0 2rpx 4rpx rgba(0, 119, 255, 0.2);
}
.container.blue .company-desc {
  color: rgba(255, 255, 255, 0.9);
}
.container .header-card {
  padding: 60rpx 40rpx;
  background: transparent;
  border: none;
  text-align: center;
  box-sizing: border-box;
}
.container .header-card .company-logo {
  width: 160rpx;
  height: 160rpx;
  margin: 0rpx auto 40rpx;
  border-radius: 40rpx;
  padding: 20rpx;
  border: 1px solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}
.container .header-card .company-logo image {
  width: 100%;
  height: 100%;
}
.container .header-card .company-name {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  display: block;
  color: #FFFFFF;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}
.container .header-card .company-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}
.container .info-card {
  margin: 0rpx 20rpx;
}
.container .info-card .info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  transition: background-color 0.3s ease;
}
.container .info-card .info-item:last-child {
  border-bottom: none;
}
.container .info-card .info-item:active {
  background-color: rgba(0, 168, 255, 0.1);
}
.container .info-card .info-item .info-left {
  display: flex;
  align-items: center;
}
.container .info-card .info-item .info-left .icon-box {
  color: #0077FF;
  font-size: 40rpx;
  background: rgba(0, 119, 255, 0.1);
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  margin-right: 20rpx;
  transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
}
.container .info-card .info-item .info-left .icon-box .iconfont {
  width: 48rpx;
  height: 48rpx;
}
.container .info-card .info-item .info-left .icon-box.icon-phone {
  background: rgba(0, 168, 255, 0.1);
}
.container .info-card .info-item .info-left .icon-box.icon-email {
  background: rgba(0, 191, 166, 0.1);
}
.container .info-card .info-item .info-left .icon-box.icon-website {
  background: rgba(115, 103, 240, 0.1);
}
.container .info-card .info-item .info-left .icon-box.icon-location {
  background: rgba(255, 159, 67, 0.1);
}
.container .info-card .info-item .info-left .info-content .info-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 8rpx;
  display: block;
}
.container .info-card .info-item .info-left .info-content .info-value {
  font-size: 28rpx;
  color: #FFFFFF;
}
.container .info-card .info-item .action-button {
  background: rgba(0, 119, 255, 0.1);
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  border: 1px solid rgba(0, 119, 255, 0.2);
}
.container .info-card .info-item .action-button text {
  font-size: 26rpx;
  color: #0077FF;
}

