.container {
  min-height: 100vh;
  background-color: #0A1A2F;
  padding: 20rpx;
  box-sizing: border-box;
  transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
}
.container .header {
  padding: 40rpx 20rpx;
}
.container .header .title {
  font-size: 40rpx;
  font-weight: bold;
  color: #FFFFFF;
}
.container .content-card {
  background: #122642;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  border: 1px solid rgba(255, 255, 255, 0.1);
  transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  padding: 30rpx;
  margin: 0 20rpx 30rpx;
}
.container .content-card .input-group {
  margin-bottom: 30rpx;
}
.container .content-card .input-group .label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 16rpx;
  display: block;
}
.container .content-card .input-group .input {
  width: 100%;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #FFFFFF;
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-sizing: border-box;
}
.container .content-card .input-group .input::-webkit-input-placeholder {
  color: rgba(255, 255, 255, 0.6);
}
.container .content-card .input-group .input::placeholder {
  color: rgba(255, 255, 255, 0.6);
}
.container .content-card .button-group {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
}
.container .content-card .button-group .btn {
  flex: 1;
  margin: 0 10rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: rgba(0, 119, 255, 0.1);
  color: #0077FF;
  font-size: 28rpx;
  border-radius: 12rpx;
  border: 1px solid rgba(0, 119, 255, 0.2);
}
.container .content-card .button-group .btn:first-child {
  margin-left: 0;
}
.container .content-card .button-group .btn:last-child {
  margin-right: 0;
}
.container .content-card .button-group .btn.copy {
  background: rgba(0, 119, 255, 0.2);
}
.container .content-card .button-group .btn:active {
  opacity: 0.8;
}
.container .content-card .result-box .label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 16rpx;
  display: block;
}
.container .content-card .result-box .result {
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  min-height: 120rpx;
}
.container .content-card .result-box .result .result-text {
  font-size: 28rpx;
  color: #FFFFFF;
  word-break: break-all;
}
.container .example-card {
  background: #122642;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  border: 1px solid rgba(255, 255, 255, 0.1);
  transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  padding: 30rpx;
  margin: 0 20rpx;
}
.container .example-card .subtitle {
  font-size: 32rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 20rpx;
  display: block;
}
.container .example-card .example-item {
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
}
.container .example-card .example-item:active {
  background: rgba(255, 255, 255, 0.1);
}
.container .example-card .example-item .example-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 10rpx;
  display: block;
}
.container .example-card .example-item .example-url {
  font-size: 26rpx;
  color: #0077FF;
  word-break: break-all;
}

