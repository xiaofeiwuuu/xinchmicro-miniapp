.container {
  min-height: 100vh;
  background-color: #0A1A2F;
  padding: 20rpx;
  box-sizing: border-box;
  transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  padding: 0;
  height: 90vh;
}
.container :deep(.zb-table) {
  background: #122642;
}
.container :deep(.zb-table) .zb-table-header {
  background: #0f1f36;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}
.container :deep(.zb-table) .zb-table-header .zb-table-cell {
  color: rgba(255, 255, 255, 0.8);
  font-weight: 500;
  background: #0f1f36;
}
.container :deep(.zb-table) .zb-table-header .zb-table-cell.fixed-left::after {
  content: '';
  position: absolute;
  right: 0;
  top: 20%;
  height: 60%;
  width: 1px;
  background: rgba(255, 255, 255, 0.05);
}
.container :deep(.zb-table) .zb-table-row {
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  transition: background-color 0.3s ease;
}
.container :deep(.zb-table) .zb-table-row:active {
  background: rgba(255, 255, 255, 0.05);
}
.container :deep(.zb-table) .zb-table-row .zb-table-cell {
  color: #FFFFFF;
  background: #122642;
}
.container :deep(.zb-table) .zb-table-row .zb-table-cell.fixed-left::after {
  content: '';
  position: absolute;
  right: 0;
  top: 20%;
  height: 60%;
  width: 1px;
  background: rgba(255, 255, 255, 0.05);
}
.container .empty-state {
  text-align: center;
  padding: 100rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.container .empty-state .iconfont {
  font-size: 80rpx;
  color: rgba(255, 255, 255, 0.2);
  margin-bottom: 20rpx;
}
.container .empty-state text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
}
.container .empty-state text:not(.iconfont) {
  margin-top: 10rpx;
}
.container .load-more {
  text-align: center;
  padding: 30rpx;
  color: rgba(255, 255, 255, 0.6);
  font-size: 28rpx;
}
.container .load-more:active {
  opacity: 0.7;
}

