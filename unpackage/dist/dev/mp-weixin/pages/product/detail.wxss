.container {
  min-height: 100vh;
  background-color: #0A1A2F;
  padding: 20rpx;
  box-sizing: border-box;
  transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  padding: 0 0 30rpx;
  box-sizing: border-box;
}
.container .product-detail .header-card {
  background: rgba(18, 38, 66, 0.8);
  border: 1px solid rgba(255, 255, 255, 0.05);
  transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  padding: 60rpx 40rpx;
  border-radius: 0 0 30rpx 30rpx;
  margin: -20rpx -20rpx 30rpx;
  margin: 0;
  background: #0e1a2d;
}
.container .product-detail .header-card .product-info .product-name {
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  display: block;
  color: #FFFFFF;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}
.container .product-detail .header-card .product-info .catalog-name {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}
.container .product-detail .section-card {
  background: #122642;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  border: 1px solid rgba(255, 255, 255, 0.1);
  transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  margin: 30rpx 20rpx;
  overflow: hidden;
}
.container .product-detail .section-card .section-header {
  padding: 30rpx;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}
.container .product-detail .section-card .section-header .section-title {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 500;
}
.container .product-detail .section-card .params-list .param-item {
  display: flex;
  padding: 24rpx 30rpx;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  transition: background-color 0.3s ease;
}
.container .product-detail .section-card .params-list .param-item:last-child {
  border-bottom: none;
}
.container .product-detail .section-card .params-list .param-item:active {
  background-color: rgba(0, 168, 255, 0.1);
}
.container .product-detail .section-card .params-list .param-item .param-label {
  width: 280rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}
.container .product-detail .section-card .params-list .param-item .param-value {
  flex: 1;
  font-size: 28rpx;
  color: #FFFFFF;
}
.container .product-detail .section-card .pdf-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}
.container .product-detail .section-card .pdf-loading .loading-icon {
  font-size: 48rpx;
  color: #0077FF;
  margin-bottom: 20rpx;
  -webkit-animation: rotate 1.5s linear infinite;
          animation: rotate 1.5s linear infinite;
}
.container .product-detail .section-card .pdf-loading .loading-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}
.container .product-detail .section-card .pdf-box {
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: background-color 0.3s ease;
}
.container .product-detail .section-card .pdf-box:active {
  background-color: rgba(0, 168, 255, 0.1);
}
.container .product-detail .section-card .pdf-box .pdf-name {
  font-size: 28rpx;
  color: #FFFFFF;
}
.container .product-detail .section-card .pdf-box .download-text {
  font-size: 28rpx;
  color: #0077FF;
  background: rgba(0, 119, 255, 0.1);
  padding: 12rpx 40rpx;
  border-radius: 30rpx;
  border: 1px solid rgba(0, 119, 255, 0.2);
}
.container .product-detail .section-card .pdf-box.tip-box {
  flex-direction: column;
  align-items: flex-start;
  background: rgba(0, 0, 0, 0.1);
  border-radius: 8rpx;
  margin: 0 30rpx 30rpx;
  padding: 20rpx;
}
@-webkit-keyframes rotate {
from {
    -webkit-transform: rotate(0deg);
            transform: rotate(0deg);
}
to {
    -webkit-transform: rotate(360deg);
            transform: rotate(360deg);
}
}
@keyframes rotate {
from {
    -webkit-transform: rotate(0deg);
            transform: rotate(0deg);
}
to {
    -webkit-transform: rotate(360deg);
            transform: rotate(360deg);
}
}

